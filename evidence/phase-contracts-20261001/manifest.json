    "contract": {
      "transfer-only": "Monitor transfer: bilateral contact, cube_z > 0.12m, grasp_error < 0.05m; age < 60ms.",
      "reuse-transfer": "Use the same transfer predicate and age limit in transfer AND lower.",
      "phase-aware": "Transfer predicate unchanged; lower requires bilateral contact and grasp_error < 0.05m, without the lift-height requirement. Age limit unchanged.",
      "release": "All policies stop grasp monitoring at commanded release; successful placement is checked independently from physical logs. Release safety is not certified.",
      "stop": "Bad captures spanning >=40ms or capture age >=60ms latch target hold. Decision is after the physics step; held actuator target applies at the next tick. No resume, replan or recovery budget in this experiment."
