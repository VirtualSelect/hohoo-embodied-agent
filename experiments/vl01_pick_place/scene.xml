<mujoco model="VL01 educational Cartesian gripper">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <visual><global offwidth="960" offheight="640"/><headlight ambient="0.4 0.4 0.4" diffuse="0.7 0.7 0.7"/></visual>
  <default>
    <joint damping="3" armature="0.01"/>
    <geom friction="1.2 0.005 0.0001" condim="4" solref="0.008 1" solimp="0.95 0.99 0.001"/>
  </default>
  <asset>
    <texture name="ground" type="2d" builtin="checker" rgb1=".83 .85 .83" rgb2=".76 .79 .76" width="256" height="256"/>
    <material name="ground" texture="ground" texrepeat="5 5" reflectance=".1"/>
  </asset>
  <worldbody>
    <light pos="0 -1 2" dir="0 0 -1" directional="true"/>
    <camera name="overview" pos=".7 -.85 .7" xyaxes=".77 .64 0 -.32 .38 .87"/>
    <geom name="floor" type="plane" size="1 1 .01" material="ground"/>
    <body name="bin" pos=".24 .12 0">
      <geom name="bin_floor" type="box" pos="0 0 .003" size=".08 .08 .003" rgba=".27 .47 .67 1"/>
      <geom type="box" pos="-.075 0 .028" size=".006 .08 .028" rgba=".27 .47 .67 1"/>
      <geom type="box" pos=".075 0 .028" size=".006 .08 .028" rgba=".27 .47 .67 1"/>
      <geom type="box" pos="0 -.075 .028" size=".069 .006 .028" rgba=".27 .47 .67 1"/>
      <geom type="box" pos="0 .075 .028" size=".069 .006 .028" rgba=".27 .47 .67 1"/>
    </body>
    <body name="cube" pos="0 0 .026">
      <freejoint/>
      <geom name="cube_geom" type="box" size=".02 .02 .02" mass=".05" rgba=".72 .22 .16 1"/>
    </body>
    <body name="hand" pos="0 0 .16" gravcomp="1">
      <joint name="x" type="slide" axis="1 0 0" range="-.2 .5"/>
      <joint name="y" type="slide" axis="0 1 0" range="-.25 .35"/>
      <joint name="z" type="slide" axis="0 0 1" range="-.14 .2"/>
      <geom name="palm" type="box" pos="0 0 .065" size=".065 .03 .015" mass=".2" rgba=".22 .31 .29 1"/>
      <site name="grip_center" size=".004" rgba="1 .7 .2 1"/>
      <body name="left" pos="-.05 0 0" gravcomp="1">
        <joint name="left_slide" type="slide" axis="1 0 0" range="0 .035"/>
        <geom name="left_pad" type="box" pos="0 0 .005" size=".008 .025 .023" mass=".04" rgba=".36 .55 .46 1"/>
      </body>
      <body name="right" pos=".05 0 0" gravcomp="1">
        <joint name="right_slide" type="slide" axis="-1 0 0" range="0 .035"/>
        <geom name="right_pad" type="box" pos="0 0 .005" size=".008 .025 .023" mass=".04" rgba=".36 .55 .46 1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <position name="x_target" joint="x" kp="2000" kv="90" ctrlrange="-.2 .5" forcerange="-100 100"/>
    <position name="y_target" joint="y" kp="2000" kv="90" ctrlrange="-.25 .35" forcerange="-100 100"/>
    <position name="z_target" joint="z" kp="2000" kv="90" ctrlrange="-.14 .2" forcerange="-100 100"/>
    <position name="left_target" joint="left_slide" kp="300" kv="3" ctrlrange="0 .035" forcerange="-12 12"/>
    <position name="right_target" joint="right_slide" kp="300" kv="3" ctrlrange="0 .035" forcerange="-12 12"/>
  </actuator>
</mujoco>
