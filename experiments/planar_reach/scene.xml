<mujoco model="Planar force-controlled teaching actuator">
 <option timestep="0.002" gravity="0 0 0" integrator="implicitfast"/>
 <visual><global offwidth="800" offheight="480"/></visual>
 <worldbody>
  <light pos="0.3 0 2"/>
  <camera name="top" pos=".3 0 1.2" xyaxes="1 0 0 0 1 0"/>
  <geom name="floor" type="plane" pos="0 0 -.02" size="1 1 .01" rgba=".85 .88 .85 1" contype="0" conaffinity="0"/>
  <geom name="wall" type="box" pos=".3 0 .035" size=".04 .09 .05" rgba=".65 .3 .22 1"/>
  <site name="goal" pos=".6 0 .035" size=".015" rgba=".2 .5 .8 1"/>
  <body name="mover" pos="0 0 .035">
   <joint name="x" type="slide" axis="1 0 0" damping="0"/>
   <joint name="y" type="slide" axis="0 1 0" damping="0"/>
   <geom name="ball" type="sphere" size=".035" mass="1" rgba=".22 .48 .35 1"/>
  </body>
 </worldbody>
 <actuator><motor joint="x" ctrllimited="true" ctrlrange="-5 5"/><motor joint="y" ctrllimited="true" ctrlrange="-5 5"/></actuator>
</mujoco>
